// Cyber Compliance data model
//
// Design principle: master Controls are framework-agnostic and never carry
// an organization's implementation status. Status/owner/evidence/notes live
// on ControlAssessment, which is scoped to one Organization's Assessment.
// New frameworks are added as data (Framework + FrameworkRequirement rows),
// never as schema changes.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Identity (foundation for future auth; Phase 1 has no login flow)
// ---------------------------------------------------------------------------

enum UserRole {
  ADMIN
  ASSESSOR
  TECHNICIAN
  CLIENT
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  role      UserRole @default(ASSESSOR)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assessmentsAsAssessor    Assessment[]        @relation("AssessmentAssessor")
  controlAssessmentsOwned  ControlAssessment[]  @relation("ControlAssessmentOwner")
  controlAssessmentsAssessed ControlAssessment[] @relation("ControlAssessmentAssessor")
  evidenceCollected        Evidence[]           @relation("EvidenceCollectedBy")
  remediationItemsOwned    RemediationItem[]    @relation("RemediationOwner")
  auditLogEntries          AuditLog[]           @relation("AuditLogActor")

  @@map("users")
}

// ---------------------------------------------------------------------------
// Organizations (MSP clients)
// ---------------------------------------------------------------------------

model Organization {
  id             String   @id @default(cuid())
  name           String
  legalName      String?
  primaryContact String?
  email          String?
  phone          String?
  industry       String?
  employeeCount  Int?
  endpointCount  Int?
  serverCount    Int?
  location       String?
  notes          String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  assessments      Assessment[]
  remediationItems RemediationItem[]

  @@index([name])
  @@map("organizations")
}

// ---------------------------------------------------------------------------
// Frameworks & requirements (data-driven, never hard-coded)
// ---------------------------------------------------------------------------

model Framework {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  version     String?
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  requirements         FrameworkRequirement[]
  assessmentFrameworks AssessmentFramework[]

  @@map("frameworks")
}

model FrameworkRequirement {
  id          String   @id @default(cuid())
  frameworkId String
  code        String // e.g. "5.2", "AP-1", "4.7.3"
  title       String?
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  framework Framework                 @relation(fields: [frameworkId], references: [id], onDelete: Cascade)
  mappings  ControlFrameworkMapping[]

  @@unique([frameworkId, code])
  @@index([frameworkId])
  @@map("framework_requirements")
}

// ---------------------------------------------------------------------------
// Master controls (framework-agnostic; no org-specific data here)
// ---------------------------------------------------------------------------

model Control {
  id            String   @id @default(cuid())
  controlNumber String   @unique
  name          String
  description   String?
  guidance      String?
  category      String?
  isDeprecated  Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  frameworkMappings  ControlFrameworkMapping[]
  controlAssessments ControlAssessment[]

  @@index([category])
  @@map("controls")
}

// Explicit many-to-many join: one Control <-> many FrameworkRequirements,
// and one FrameworkRequirement <-> many Controls.
model ControlFrameworkMapping {
  id                     String   @id @default(cuid())
  controlId              String
  frameworkRequirementId String
  notes                  String?
  createdAt              DateTime @default(now())

  control              Control               @relation(fields: [controlId], references: [id], onDelete: Cascade)
  frameworkRequirement FrameworkRequirement  @relation(fields: [frameworkRequirementId], references: [id], onDelete: Cascade)

  @@unique([controlId, frameworkRequirementId])
  @@index([frameworkRequirementId])
  @@map("control_framework_mappings")
}

// ---------------------------------------------------------------------------
// Assessments (per-organization, historical, never overwritten)
// ---------------------------------------------------------------------------

enum AssessmentStatus {
  DRAFT
  IN_PROGRESS
  COMPLETED
  ARCHIVED
}

model Assessment {
  id             String           @id @default(cuid())
  organizationId String
  name           String
  status         AssessmentStatus @default(DRAFT)
  assessmentDate DateTime?
  startedDate    DateTime?
  completedDate  DateTime?
  assessorId     String?
  notes          String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assessor     User?                 @relation("AssessmentAssessor", fields: [assessorId], references: [id])
  frameworks   AssessmentFramework[]
  controlAssessments ControlAssessment[]
  meetings     Meeting[]

  @@index([organizationId])
  @@map("assessments")
}

// ---------------------------------------------------------------------------
// Meetings: a recurring working session that walks through a batch of an
// assessment's controls (agenda + generated action items are derived at
// render time from the controls attached below, never stored).
// ---------------------------------------------------------------------------

enum MeetingStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

model Meeting {
  id             String        @id @default(cuid())
  assessmentId   String
  sequenceNumber Int
  scheduledAt    DateTime
  status         MeetingStatus @default(SCHEDULED)
  notes          String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  assessment         Assessment          @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  controlAssessments ControlAssessment[]

  @@unique([assessmentId, sequenceNumber])
  @@index([assessmentId])
  @@map("meetings")
}

// Join so one assessment can cover multiple frameworks
model AssessmentFramework {
  id           String   @id @default(cuid())
  assessmentId String
  frameworkId  String
  createdAt    DateTime @default(now())

  assessment Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  framework  Framework  @relation(fields: [frameworkId], references: [id], onDelete: Restrict)

  @@unique([assessmentId, frameworkId])
  @@index([frameworkId])
  @@map("assessment_frameworks")
}

// ---------------------------------------------------------------------------
// Control assessments: the organization's assessment of a master Control,
// scoped to one Assessment. This is where all client-specific state lives.
// ---------------------------------------------------------------------------

enum ControlAssessmentStatus {
  NOT_ASSESSED
  NOT_STARTED
  IN_PROGRESS
  IMPLEMENTED
  NOT_APPLICABLE
}

model ControlAssessment {
  id             String                   @id @default(cuid())
  assessmentId   String
  controlId      String
  status         ControlAssessmentStatus  @default(NOT_ASSESSED)
  isApplicable   Boolean                  @default(true)
  ownerId        String?
  assessorId     String?
  meetingId      String?
  notes          String?
  lastReviewedAt DateTime?
  nextReviewAt   DateTime?
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt

  assessment Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  control    Control    @relation(fields: [controlId], references: [id], onDelete: Restrict)
  owner      User?      @relation("ControlAssessmentOwner", fields: [ownerId], references: [id])
  assessor   User?      @relation("ControlAssessmentAssessor", fields: [assessorId], references: [id])
  meeting    Meeting?   @relation(fields: [meetingId], references: [id], onDelete: SetNull)

  evidence          Evidence[]
  remediationItems  RemediationItem[]

  @@unique([assessmentId, controlId])
  @@index([controlId])
  @@index([status])
  @@index([meetingId])
  @@map("control_assessments")
}

// ---------------------------------------------------------------------------
// Evidence
// ---------------------------------------------------------------------------

enum EvidenceType {
  SCREENSHOT
  POLICY
  BACKUP_REPORT
  VULNERABILITY_REPORT
  SECURITY_AWARENESS_REPORT
  CONFIGURATION_EXPORT
  TICKET
  EXTERNAL_URL
  ASSESSMENT_DOCUMENT
  OTHER
}

model Evidence {
  id                  String       @id @default(cuid())
  controlAssessmentId String
  title               String
  description         String?
  evidenceType         EvidenceType @default(OTHER)
  fileReference        String?
  externalUrl          String?
  dateCollected        DateTime?
  collectedById        String?
  reviewDate           DateTime?
  notes                String?
  createdAt             DateTime @default(now())
  updatedAt              DateTime @updatedAt

  controlAssessment ControlAssessment @relation(fields: [controlAssessmentId], references: [id], onDelete: Cascade)
  collectedBy       User?             @relation("EvidenceCollectedBy", fields: [collectedById], references: [id])

  @@index([controlAssessmentId])
  @@map("evidence")
}

// ---------------------------------------------------------------------------
// Remediation
// ---------------------------------------------------------------------------

enum RemediationStatus {
  OPEN
  IN_PROGRESS
  BLOCKED
  COMPLETED
  ACCEPTED_RISK
}

enum RemediationPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model RemediationItem {
  id                  String               @id @default(cuid())
  title               String
  description         String?
  organizationId      String
  controlAssessmentId String?
  ownerId             String?
  priority            RemediationPriority  @default(MEDIUM)
  status              RemediationStatus    @default(OPEN)
  dueDate             DateTime?
  completedDate       DateTime?
  notes               String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  organization      Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  controlAssessment ControlAssessment? @relation(fields: [controlAssessmentId], references: [id], onDelete: SetNull)
  owner             User?              @relation("RemediationOwner", fields: [ownerId], references: [id])

  @@index([organizationId])
  @@index([status])
  @@index([dueDate])
  @@map("remediation_items")
}

// ---------------------------------------------------------------------------
// Audit trail
// ---------------------------------------------------------------------------

model AuditLog {
  id            String   @id @default(cuid())
  entityType    String
  entityId      String
  action        String
  actorId       String?
  previousValue Json?
  newValue      Json?
  createdAt     DateTime @default(now())

  actor User? @relation("AuditLogActor", fields: [actorId], references: [id])

  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}
